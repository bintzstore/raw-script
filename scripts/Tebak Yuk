-- Variabel untuk tracking kata saat ini
local currentIndex = 1
local currentCategoryList = nil
local isShowingCategory = false

-- Fungsi untuk update tampilan kata
local function updateWordDisplay()
    if isShowingCategory and currentCategoryList then
        if #currentCategoryList > 0 then
            wordLabel.Text = currentCategoryList[currentIndex]
        else
            wordLabel.Text = "Tidak ada kata"
        end
    else
        if #allWords > 0 then
            wordLabel.Text = allWords[currentIndex]
        end
    end
end

-- Fungsi untuk menampilkan kata dari kategori tertentu
local function showCategoryWords(categoryName)
    if categoryWords[categoryName] then
        currentCategoryList = categoryWords[categoryName]
        isShowingCategory = true
        currentIndex = 1
        updateWordDisplay()
        
        -- Tampilkan notifikasi kecil (opsional)
        wordDisplayFrame.BackgroundColor3 = Color3.fromRGB(75, 55, 95)
        task.wait(0.2)
        wordDisplayFrame.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
    end
end

-- Fungsi untuk reset ke semua kata
local function resetToAllWords()
    isShowingCategory = false
    currentCategoryList = nil
    currentIndex = 1
    updateWordDisplay()
end

-- Tombol navigasi
prevBtn.MouseButton1Click:Connect(function()
    if isShowingCategory and currentCategoryList then
        currentIndex = currentIndex - 1
        if currentIndex < 1 then
            currentIndex = #currentCategoryList
        end
    else
        currentIndex = currentIndex - 1
        if currentIndex < 1 then
            currentIndex = #allWords
        end
    end
    updateWordDisplay()
end)

nextBtn.MouseButton1Click:Connect(function()
    if isShowingCategory and currentCategoryList then
        currentIndex = currentIndex + 1
        if currentIndex > #currentCategoryList then
            currentIndex = 1
        end
    else
        currentIndex = currentIndex + 1
        if currentIndex > #allWords then
            currentIndex = 1
        end
    end
    updateWordDisplay()
end)

-- Buat tombol untuk setiap kategori
local categoryButtons = {}
for categoryName, words in pairs(categoryWords) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    btn.Text = categoryName:gsub("_", " ")
    btn.TextColor3 = Color3.fromRGB(220, 220, 240)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamSemibold
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = categoryGrid
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn
    
    -- Hover effect
    btn.MouseEnter:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    end)
    
    btn.MouseButton1Click:Connect(function()
        showCategoryWords(categoryName)
    end)
    
    categoryButtons[categoryName] = btn
end

-- Tombol reset untuk kembali ke semua kata
local resetBtn = Instance.new("TextButton")
resetBtn.Size = UDim2.new(1, 0, 0, 40)
resetBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
resetBtn.Text = "🔄 Tampilkan Semua Kata"
resetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
resetBtn.TextSize = 12
resetBtn.Font = Enum.Font.GothamBold
resetBtn.BorderSizePixel = 0
resetBtn.Parent = scrollingFrame

local resetCorner = Instance.new("UICorner")
resetCorner.CornerRadius = UDim.new(0, 8)
resetCorner.Parent = resetBtn

resetBtn.MouseButton1Click:Connect(function()
    resetToAllWords()
end)

-- Close button
closeBtn.MouseButton1Click:Connect(function()
    gui:Destroy()
end)

-- Drag functionality
local dragging = false
local dragStart = nil
local frameStart = nil

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        frameStart = mainFrame.Position
    end
end)

titleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(frameStart.X.Scale, frameStart.X.Offset + delta.X, frameStart.Y.Scale, frameStart.Y.Offset + delta.Y)
    end
end)

-- Tampilkan kata pertama
updateWordDisplay()

print("GUI Kata Kategori berhasil dimuat!")
print("Total kata: " .. #allWords)
print("Total kategori: " .. #categoryButtons)