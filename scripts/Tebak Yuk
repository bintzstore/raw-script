-- Kumpulkan semua kata dari semua kategori
local allWords = {}
local categoryWords = {} -- Menyimpan daftar kata per kategori

-- Fungsi untuk mengumpulkan semua kata
local function collectWords()
    for difficulty, categories in pairs(v1) do
        if difficulty ~= "TTS_OVERRIDES" then
            for category, words in pairs(categories) do
                if type(words) == "table" then
                    if not categoryWords[category] then
                        categoryWords[category] = {}
                    end
                    for _, word in ipairs(words) do
                        table.insert(allWords, word)
                        table.insert(categoryWords[category], word)
                    end
                end
            end
        end
    end
end

collectWords()

